{
  "name": "manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev --webpack",
    "build": "bun --bun next build --webpack",
    "start": "bun --bun next start",
    "lint": "eslint",
    "test": "bun test",
    "migrate:platform": "bun scripts/migrate-platform.ts",
    "typecheck": "bun --bun tsc --noEmit",
    "smoke:runtime": "bun scripts/smoke-runtime.ts",
    "smoke:http-agent": "bun scripts/smoke-http-agent.ts",
    "smoke:step6-gateway": "bun scripts/smoke-step6-gateway.ts",
    "typecheck:contracts": "bun --bun tsc -p packages/contracts/tsconfig.json",
    "check:boundaries": "bun scripts/check-package-boundaries.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "geist": "^1.7.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "undici": "7.30.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.14",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": "1.3.13"
  }
}
